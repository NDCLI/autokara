{
  "name": "kara-studio",
  "version": "0.1.0",
  "description": "Windows-first karaoke timing and lyric editor",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "desktop:dev": "concurrently -k \"npm:dev\" \"npm:desktop:electron\"",
    "desktop:electron": "wait-on http://127.0.0.1:4173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:4173 electron .",
    "build": "tsc --noEmit && vite build",
    "desktop:build": "vite build --base=./",
    "desktop:dist": "npm run desktop:build && electron-packager . KaraStudio --platform=win32 --arch=x64 --out=release --overwrite --asar --prune=true",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^10.0.0",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-packager": "^17.1.2",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "wait-on": "^9.0.0"
  }
}
