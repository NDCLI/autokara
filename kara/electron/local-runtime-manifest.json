{
  "manifestVersion": 1,
  "runtime": {
    "python": {
      "minimum": "3.10",
      "maximumExclusive": "3.13",
      "supported": [
        "3.10",
        "3.11",
        "3.12"
      ]
    },
    "packages": {
      "faster-whisper": {
        "distribution": "faster-whisper",
        "module": "faster_whisper",
        "required": true,
        "testedVersion": "1.2.1",
        "versionPolicy": "vietkara-reference"
      },
      "av": {
        "distribution": "av",
        "module": "av",
        "required": true,
        "testedVersion": "19.0.1",
        "versionPolicy": "vietkara-reference"
      },
      "ctranslate2": {
        "distribution": "ctranslate2",
        "module": "ctranslate2",
        "required": true,
        "testedVersion": "4.8.3",
        "versionPolicy": "vietkara-reference"
      },
      "demucs": {
        "distribution": "demucs",
        "module": "demucs",
        "required": false,
        "versionPolicy": "unverified",
        "requiredWhen": "vocal-separation-enabled"
      },
      "stable-ts": {
        "distribution": "stable-ts",
        "module": "stable_whisper",
        "required": true,
        "testedVersion": "2.19.1",
        "versionPolicy": "pinned-direct-alignment"
      }
    },
    "models": {
      "asr": "selected-by-user",
      "forcedAlignment": "selected-by-language-or-user"
    },
    "testedProfiles": [
      {
        "id": "vietkara-windows-x64-python-3.12-cpu",
        "requirements": "runtime/windows-python312-cpu-requirements.lock.txt",
        "python": "3.12.10",
        "packages": {
          "ctranslate2": "4.8.3",
          "faster-whisper": "1.2.1",
          "av": "19.0.1",
          "stable-ts": "2.19.1"
        }
      }
    ]
  },
  "notes": [
    "Recreate the verified CPU environment with: python -m venv .venv; .venv\\Scripts\\python -m pip install -r runtime/windows-python312-cpu-requirements.lock.txt. This lock includes Stable-ts 2.19.1 for direct lyric alignment. Select that interpreter in Kara Studio.",
    "The pinned Vietkara-reference Windows x64 CPU profile is Python 3.12.10, stable-ts 2.19.1, faster-whisper 1.2.1, PyAV 19.0.1 and CTranslate2 4.8.3. Python 3.10/3.11, other operating systems and GPU inference are not covered by this profile.",
    "Model revisions are selected by the user and are not pinned; report them at runtime before treating a run as reproducible.",
    "CUDA availability is detected from CTranslate2 and does not guarantee that a selected model can load on the device."
  ]
}
